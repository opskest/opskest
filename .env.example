# Opskest configuration. Every setting is optional: with no .env at all it
# starts on http://localhost:8080, keeps its data in ./data and ./backups, and
# generates its own encryption key. Copy this file to .env to change anything.
# A real environment variable that is set (not empty) wins over this file.
# Format: KEY=VALUE lines, # comments, optional quotes around a value.

# --- The usual three -------------------------------------------------------

# The address people open, with scheme. Set this for anything other than local
# use: https:// turns on Secure cookies, and links in alerts use it. First-run
# setup and sign-in are refused (403) when the browser's address differs from
# this in scheme, host or port. Default: http://localhost:<port>.
# Opskest does not read X-Forwarded-Proto or Host from a proxy; this decides.
# APP_URL=https://status.example.com

# Port to listen on. Hosts that assign a port (cPanel, process managers, PaaS)
# usually provide PORT; LISTEN_ADDR (e.g. 127.0.0.1:8080) takes priority.
# PORT=8080

# Display timezone for charts, daily rollups, the daily backup hour and new
# maintenance windows. Empty = the TZ variable, then this server's own
# timezone (UTC if it has none).
# DISPLAY_TZ=Europe/Berlin

# --- Storage ---------------------------------------------------------------

# Relative paths are relative to where you start Opskest. The Docker image
# sets /data and /backups itself; leave these two unset for Docker Compose,
# because this file is passed into the container and would override them.
# DATA_DIR=./data
# BACKUP_DIR=./backups

# 64 hex characters (openssl rand -hex 32) that encrypt channel, monitor and
# two-factor secrets. Leave empty to have one generated on first start and
# kept in DATA_DIR/encryption.key. Either way, keep it with your backups: a
# database copy cannot be read without it.
# SECRET_ENCRYPTION_KEY=

# --- Optional --------------------------------------------------------------

# Label for where checks run from, shown in the UI. Empty = "This server".
# SERVER_REGION=US East (Virginia)

# Bearer token for GET /metrics (Prometheus). Empty disables the endpoint.
# METRICS_TOKEN=

# Concurrent checks: 1-2048 (default 256).
# CHECK_CONCURRENCY=256

# debug | info | warn | error
# LOG_LEVEL=info

# Read a different env file instead of ./.env
# OPSKEST_ENV_FILE=/etc/opskest.env

# --- Docker Compose only ---------------------------------------------------

# The container listens on 8080 inside and is published on OPSKEST_HOST and
# OPSKEST_PORT. APP_URL defaults to http://localhost:<OPSKEST_PORT>, so for
# local use you only need the port; for a real domain set APP_URL above to the
# address people open before the first start. Do not set DATA_DIR, BACKUP_DIR,
# PORT or LISTEN_ADDR here for Compose: the image sets them.
#
# Host port and address the container is published on. Keep 127.0.0.1 behind
# a reverse proxy.
# OPSKEST_PORT=8085
# OPSKEST_HOST=127.0.0.1
# Host folders mounted as /data and /backups (create them and give uid 65532
# ownership before the first start).
# OPSKEST_DATA_DIR=./data
# BACKUP_HOST_DIR=./backups
# Image tag to run (ghcr.io/opskest/opskest:<OPSKEST_VERSION>). Pin it to stay
# on a version.
# OPSKEST_VERSION=latest

# Self-update restart (plain binary only; see Docs.md, "Updates"). "self"
# (default): Opskest starts the new binary itself. "exit": it only shuts down
# cleanly (status 0) and your process manager (systemd Restart=always, a
# Windows service wrapper) must start the new file.
# OPSKEST_UPDATE_RESTART=self
